rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidUrl(url) {
      return url is string && url.size() <= 500 &&
        (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    // ── Workspace (no sharing field — sharing lives on sharedFolders collection) ──

    function isValidWorkspace(data) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'authorName']) &&
             data.keys().hasOnly(['id', 'ownerId', 'title', 'authorName',
                                  'themeColor', 'childrenIds', 'createdAt']) &&
             isValidString(data.id, 36, 36) &&
             isValidString(data.ownerId, 20, 128) &&
             isValidString(data.title, 1, 50) &&
             isValidString(data.authorName, 0, 100) &&
             (!('childrenIds' in data) ||
              (data.childrenIds is list && data.childrenIds.size() <= 500)) &&
             (!('themeColor' in data) || isValidString(data.themeColor, 1, 30));
    }

    function isValidWorkspaceUpdate(data) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['ownerId', 'id', 'createdAt']) &&
             changed.hasOnly(['title', 'authorName', 'childrenIds', 'themeColor']) &&
             (!changed.hasAll(['title'])      || isValidString(data.title, 1, 50)) &&
             (!changed.hasAll(['authorName']) || isValidString(data.authorName, 0, 100)) &&
             (!changed.hasAll(['themeColor']) || isValidString(data.themeColor, 1, 30)) &&
             (!changed.hasAll(['childrenIds']) ||
              (data.childrenIds is list && data.childrenIds.size() <= 500));
    }

    // ── Items ──

    function isValidLinkItem(data) {
      return data.keys().hasAll(['id', 'parentId', 'type', 'title', 'createdAt']) &&
             data.keys().hasOnly(['id', 'parentId', 'type', 'title', 'url', 'content',
                                  'childrenIds', 'createdAt', 'sharedVia']) &&
             isValidString(data.id, 36, 36) &&
             isValidString(data.parentId, 1, 100) &&
             data.type in ['folder', 'link', 'note'] &&
             isValidString(data.title, 1, 200) &&
             data.createdAt is number &&
             (!('url' in data)     || isValidUrl(data.url)) &&
             (!('content' in data) || isValidString(data.content, 0, 100000)) &&
             (!('childrenIds' in data) ||
              (data.childrenIds is list && data.childrenIds.size() <= 500)) &&
             (!('sharedVia' in data) || isValidString(data.sharedVia, 36, 36));
    }

    function isValidLinkItemUpdate(data) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['id', 'createdAt', 'type']) &&
             changed.hasOnly(['parentId', 'title', 'url', 'content', 'childrenIds', 'sharedVia']) &&
             (!changed.hasAll(['title'])    || isValidString(data.title, 1, 200)) &&
             (!changed.hasAll(['parentId']) || isValidString(data.parentId, 1, 100)) &&
             (!changed.hasAll(['url']) ||
              !('url' in data) || isValidUrl(data.url)) &&
             (!changed.hasAll(['content']) ||
              !('content' in data) || isValidString(data.content, 0, 100000)) &&
             (!changed.hasAll(['childrenIds']) ||
              !('childrenIds' in data) ||
              (data.childrenIds is list && data.childrenIds.size() <= 500)) &&
             (!changed.hasAll(['sharedVia']) ||
              !('sharedVia' in data) ||
              isValidString(data.sharedVia, 36, 36));
    }

    // ── Shared Folders Registry ──

    function isValidSharedFolder(data) {
      return data.keys().hasAll(['workspaceId', 'ownerId',
                                  'folderTitle', 'authorName', 'sharedAt']) &&
             data.keys().hasOnly(['workspaceId', 'ownerId', 'folderTitle',
                                  'authorName', 'themeColor', 'sharedAt']) &&
             isValidString(data.workspaceId, 36, 36) &&
             isValidString(data.ownerId, 20, 128) &&
             isValidString(data.folderTitle, 1, 200) &&
             isValidString(data.authorName, 0, 100) &&
             (!('themeColor' in data) || isValidString(data.themeColor, 1, 30));
    }

    // ══════════════════════════════════════
    // Default: deny everything
    // ══════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

    // ══════════════════════════════════════
    // /sharedFolders/{folderId}
    // Public share registry — UUID provides security through obscurity
    // ══════════════════════════════════════
    match /sharedFolders/{folderId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       isValidSharedFolder(request.resource.data) &&
                       request.resource.data.sharedAt == request.time;

      allow update: if isAuthenticated() &&
                       resource.data.ownerId == request.auth.uid &&
                       request.resource.data.ownerId == request.auth.uid &&
                       isValidSharedFolder(request.resource.data);

      allow delete: if isAuthenticated() &&
                       resource.data.ownerId == request.auth.uid;
    }

    // ══════════════════════════════════════
    // /workspaces/{workspaceId}
    // Owner-only — sharing lives in sharedFolders, not here
    // ══════════════════════════════════════
    match /workspaces/{workspaceId} {

      allow read: if isAuthenticated() &&
                     resource.data.ownerId == request.auth.uid;

      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       isValidWorkspace(request.resource.data) &&
                       request.resource.data.createdAt == request.time;

      allow update: if isAuthenticated() &&
                       resource.data.ownerId == request.auth.uid &&
                       isValidWorkspaceUpdate(request.resource.data);

      allow delete: if isAuthenticated() &&
                       resource.data.ownerId == request.auth.uid;

      // ── /workspaces/{workspaceId}/items/{itemId} ──
      match /items/{itemId} {

        function isParentWorkspaceOwner() {
          let path = /databases/$(database)/documents/workspaces/$(workspaceId);
          return exists(path) && get(path).data.ownerId == request.auth.uid;
        }

        // Readable if:
        //   (a) you own the workspace, OR
        //   (b) the item carries a sharedVia pointing to a live sharedFolders entry
        allow read: if isAuthenticated() && (
          isParentWorkspaceOwner() ||
          ('sharedVia' in resource.data &&
           exists(/databases/$(database)/documents/sharedFolders/$(resource.data.sharedVia)))
        );

        allow create: if isAuthenticated() &&
                         isParentWorkspaceOwner() &&
                         isValidLinkItem(request.resource.data);

        allow update: if isAuthenticated() &&
                         isParentWorkspaceOwner() &&
                         isValidLinkItemUpdate(request.resource.data) &&
                         request.resource.data.id == resource.data.id;

        allow delete: if isAuthenticated() &&
                         isParentWorkspaceOwner();
      }
    }
  }
}
